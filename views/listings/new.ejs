<% layout('layouts/boilerplate') %>

<section class="form-page">
  <div>
    <p class="eyebrow">Host on Wanderlust</p>
    <h1>Create a new listing</h1>
  </div>

  <form method="POST" action="/listings" novalidate class="needs-validation listing-form" enctype="multipart/form-data">
    <div class="mb-3">
      <label class="form-label">Title</label>
      <input type="text" name="listing[title]" placeholder="Add a catchy title" class="form-control" required />
      <div class="invalid-feedback">Title is required.</div>
    </div>

    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="listing[description]" class="form-control" rows="4" required></textarea>
      <div class="invalid-feedback">Description is required.</div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-4">
        <label class="form-label">Price per night</label>
        <input type="number" min="0" name="listing[price]" placeholder="Enter price" class="form-control" required />
        <div class="invalid-feedback">Price should be valid.</div>
      </div>
      <div class="mb-3 col-md-4">
        <label class="form-label">Category</label>
        <select name="listing[category]" class="form-select" required>
          <% for (let category of categories) { %>
            <option value="<%= category %>"><%= category %></option>
          <% } %>
        </select>
      </div>
      <div class="mb-3 col-md-4">
        <label class="form-label">Max guests</label>
        <input type="number" min="1" name="listing[maxGuests]" value="2" class="form-control" required />
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-6">
        <label class="form-label">Bedrooms</label>
        <input type="number" min="0" name="listing[bedrooms]" value="1" class="form-control" required />
      </div>
      <div class="mb-3 col-md-6">
        <label class="form-label">Bathrooms</label>
        <input type="number" min="0" name="listing[bathrooms]" value="1" class="form-control" required />
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-6">
        <label class="form-label">Country</label>
        <input type="text" name="listing[country]" placeholder="Enter country" class="form-control" required />
      </div>
      <div class="mb-3 col-md-6">
        <label class="form-label">Location</label>
        <input type="text" name="listing[location]" placeholder="Enter city or area" class="form-control" required />
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Amenities</label>
      <input type="text" name="listing[amenities]" placeholder="Wifi, Kitchen, Pool" class="form-control" />
    </div>

    <div class="mb-3">
      <label class="form-label">Upload image</label>
      <input type="file" name="listing[image][url]" class="form-control" accept="image/*" />
    </div>

    <button class="btn primary-action mt-3">Add listing</button>
  </form>
</section>
