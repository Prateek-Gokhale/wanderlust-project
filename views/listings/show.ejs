<% layout('layouts/boilerplate') %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN%>";
  const listing = <%- JSON.stringify(listing) %>;
</script>

<section class="show-hero">
  <div>
    <p class="eyebrow"><%= listing.category %> in <%= listing.location %></p>
    <h1><%= listing.title %></h1>
    <p><%= listing.location %>, <%= listing.country %></p>
  </div>
  <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
    <div class="owner-actions">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  <% } %>
</section>

<img src="<%= listing.image.url %>" class="show-cover" alt="<%= listing.title %>" />

<div class="show-layout">
  <main>
    <section class="stay-summary">
      <div>
        <h2>Hosted by <%= listing.owner.username %></h2>
        <p><%= listing.maxGuests %> guests · <%= listing.bedrooms %> bedrooms · <%= listing.bathrooms %> bathrooms</p>
      </div>
      <div class="host-avatar"><%= listing.owner.username[0].toUpperCase() %></div>
    </section>

    <hr>
    <p class="description"><%= listing.description %></p>

    <% if (listing.amenities && listing.amenities.length > 0) { %>
      <section>
        <h2>What this place offers</h2>
        <div class="amenity-grid">
          <% for (let amenity of listing.amenities) { %>
            <div><i class="fa-solid fa-check"></i><%= amenity %></div>
          <% } %>
        </div>
      </section>
    <% } %>

    <section>
      <h2>Where you'll be</h2>
      <div id="map" class="map-panel">
        <div class="map-fallback">
          <strong><%= listing.location %></strong>
          <span>Exact location provided after booking.</span>
        </div>
      </div>
    </section>

    <section class="reviews-section">
      <h2>Reviews</h2>
      <% if (currUser) { %>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation review-form">
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <% for (let star = 1; star <= 5; star++) { %>
              <input type="radio" id="first-rate<%= star %>" name="review[rating]" value="<%= star %>" />
              <label for="first-rate<%= star %>" title="<%= star %> star"><%= star %> star</label>
            <% } %>
          </fieldset>
          <textarea id="comment" name="review[comment]" rows="4" class="form-control" placeholder="Share what future guests should know" required></textarea>
          <div class="invalid-feedback">Please provide a comment.</div>
          <button class="btn btn-dark mt-3">Submit Review</button>
        </form>
      <% } %>

      <div class="review-grid">
        <% for (review of listing.reviews) { %>
          <article class="review-card">
            <h3>@<%= review.author.username %></h3>
            <p class="starability-result" data-rating="<%= review.rating %>"></p>
            <p><%= review.comment %></p>
            <% if (currUser && review.author._id.equals(currUser._id)) { %>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-dark">Delete</button>
              </form>
            <% } %>
          </article>
        <% } %>
      </div>
    </section>
  </main>

  <aside class="booking-card">
    <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" novalidate>
      <p class="booking-price">&#8377;<%= listing.price.toLocaleString('en-IN') %> <span>night</span></p>
      <div class="booking-grid">
        <label>Check in
          <input type="date" name="booking[checkIn]" required>
        </label>
        <label>Check out
          <input type="date" name="booking[checkOut]" required>
        </label>
      </div>
      <label>Guests
        <input type="number" name="booking[guests]" min="1" max="<%= listing.maxGuests %>" value="1" required>
      </label>
      <button class="btn reserve-btn" <%= currUser ? '' : 'disabled' %>>Reserve</button>
      <% if (!currUser) { %>
        <p class="booking-note">Log in to reserve this stay.</p>
      <% } else { %>
        <p class="booking-note">You won't be charged yet.</p>
      <% } %>
    </form>
  </aside>
</div>

<script src="/js/map.js"></script>
