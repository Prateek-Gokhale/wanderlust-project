<% layout('layouts/boilerplate') %>

<section class="explore-header">
  <div>
    <p class="eyebrow">Homes, cabins, villas, and city stays</p>
    <h1>Find your next stay</h1>
  </div>
  <form class="price-filter" method="GET" action="/listings">
    <input type="hidden" name="q" value="<%= query.q || '' %>">
    <input type="hidden" name="category" value="<%= query.category || '' %>">
    <input type="number" name="minPrice" min="0" placeholder="Min price" value="<%= query.minPrice || '' %>">
    <input type="number" name="maxPrice" min="0" placeholder="Max price" value="<%= query.maxPrice || '' %>">
    <button class="btn btn-dark">Filter</button>
  </form>
</section>

<nav class="category-bar" aria-label="Listing categories">
  <a class="category-pill <%= !query.category ? 'active' : '' %>" href="/listings">
    <i class="fa-solid fa-border-all"></i>
    <span>All</span>
  </a>
  <% const categoryIcons = {
    'Trending': 'fa-fire',
    'Rooms': 'fa-bed',
    'Iconic Cities': 'fa-mountain-city',
    'Mountains': 'fa-mountain',
    'Castles': 'fa-fort-awesome',
    'Amazing Pools': 'fa-person-swimming',
    'Camping': 'fa-campground',
    'Farm House': 'fa-tractor',
    'Beach': 'fa-umbrella-beach',
    'Lake': 'fa-water'
  }; %>
  <% for (let category of categories) { %>
    <a class="category-pill <%= query.category === category ? 'active' : '' %>" href="/listings?category=<%= encodeURIComponent(category) %>">
      <i class="fa-solid <%= categoryIcons[category] %>"></i>
      <span><%= category %></span>
    </a>
  <% } %>
</nav>

<% if (allListings.length === 0) { %>
  <div class="empty-state">
    <h2>No stays match your search</h2>
    <p>Try a different destination, guest count, category, or price range.</p>
    <a href="/listings" class="btn btn-dark">Clear filters</a>
  </div>
<% } %>

<div class="listing-grid">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <article class="stay-card">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
        <div class="stay-card-body">
          <div>
            <h2><%= listing.title %></h2>
            <p><%= listing.location %>, <%= listing.country %></p>
            <p><%= listing.maxGuests %> guests · <%= listing.bedrooms %> beds · <%= listing.bathrooms %> baths</p>
          </div>
          <p class="price">&#8377;<%= listing.price.toLocaleString('en-IN') %> <span>/ night</span></p>
        </div>
      </article>
    </a>
  <% } %>
</div>
